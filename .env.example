# ============================================================
# 复制本文件为 .env（双击 启动.bat 会自动帮你复制），然后填你自己的值。
# .env 里全是密钥，绝对不要提交到 git、不要发给别人。
# 带【必填】的三项不改，程序不会启动。
# ============================================================

# ---------- 【必填】控制台登录密码 ----------
# 用来登录 http://127.0.0.1:8099，自己定一个（建议纯英文数字）
PANEL_PASSWORD=my-panel-pass

# ---------- 【必填】DeepSeek 密钥 ----------
# 申请地址 https://platform.deepseek.com/api_keys ，形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_KEY
# 默认就是官方地址，用第三方中转才需要改
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash 支持看图；deepseek-v4-pro 不支持看图
DEEPSEEK_MODEL=deepseek-flash

# ---------- 【必填】NapCat / OneBot v11 ----------
# 在 NapCat WebUI(默认 http://127.0.0.1:6099) 里新建「网络配置 → WebSocket 服务器」：
#   主机 127.0.0.1   端口 3001   Token 填下面这个   消息格式 array   上报自身消息 关
OB_WS_URL=ws://127.0.0.1:3001
OB_ACCESS_TOKEN=my-token-123

# ---------- 本地 Web 控制台 ----------
# 只绑本机，不要改成 0.0.0.0（那等于把控制台开到局域网上）
PANEL_HOST=127.0.0.1
PANEL_PORT=8099

# ---------- 可选 ----------
# 静态图库目录，默认 ./assets/images
IMAGE_DIR=./assets/images
# 群图片临时缓存目录，默认 ./data/tmp
TMP_DIR=./data/tmp
# 日志等级 debug | info | warn | error
LOG_LEVEL=info
